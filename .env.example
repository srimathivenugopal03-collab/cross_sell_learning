# Application Environment Mode: 'dev' (in-memory fake) or 'prod' (real services)
ENV=prod

# Logging Level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Enable Debug Bounding-Box Drawing in tmp/debug/: true or false
ENABLE_DEBUG_DRAW=false

# Web Server Host and Port
HOST=0.0.0.0
PORT=5000

# Rate Limiting (ML Endpoint Protection)
RATE_LIMIT_ENABLED=true
RATE_LIMIT_DEFAULT=60 per minute
RATE_LIMIT_STORAGE_URI=memory://

# Options: 'fake', 'tfs' (TensorFlow Serving), 'torch' (PyTorch), 'onnx', 'yolo'
DETECTOR_TYPE=tfs

# TensorFlow Serving Parameters (Used when DETECTOR_TYPE=tfs or ENV=prod)
TFS_HOST=localhost
TFS_PORT=8501
MODEL_NAME=ssd_mobilenet_v2
TFS_TIMEOUT=15

# PyTorch / TorchVision Parameters (Used when DETECTOR_TYPE=torch)
TORCH_DEVICE=cpu

# ONNX Runtime Parameters (Used when DETECTOR_TYPE=onnx)
ONNX_MODEL_PATH=models/detector.onnx

# YOLO / Ultralytics Parameters (Used when DETECTOR_TYPE=yolo)
YOLO_WEIGHTS=yolov8n.pt

# ------------------------------------------------------------------------------
# Database Storage Configuration
# ------------------------------------------------------------------------------
# Options: 'memory', 'postgres', 'mongo'
DB_TYPE=memory

# PostgreSQL / Relational Database (Primary Datastore)
# You can supply DATABASE_URL or individual POSTGRES_* parameters:
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/counter_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=counter_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# MongoDB (Document Datastore Adapter)
MONGO_HOST=localhost
MONGO_PORT=27017
MONGO_DB=prod_counter
MONGO_URI=mongodb://localhost:27017/prod_counter

